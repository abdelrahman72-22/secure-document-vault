generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

model User {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  password          String
  role              Role     @default(USER)
  twoFactorSecret   String?
  createdAt         DateTime @default(now())

  documents         Document[]
}

model Document {
  id              Int      @id @default(autoincrement())
  filename        String
  encryptedPath   String
  hash            String
  signature       String
  size            Int?
  createdAt       DateTime @default(now())

  ownerId         Int
  owner           User @relation(fields: [ownerId], references: [id])
}
